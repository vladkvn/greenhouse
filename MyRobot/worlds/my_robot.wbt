#VRML_SIM R2025a utf8
# Теплица: длинное помещение 6 x 4 м с рядами грядок и проходами.
# Робот с лидаром/камерой/датчиками ездит по проходам и строит карту.
# Только базовые ноды Webots — открывается без интернета и внешних PROTO.

WorldInfo {
  basicTimeStep 16
  info [
    "Теплица: ряды грядок и проходы. Колёсный робот строит карту по лидару."
  ]
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 -4.5 5.5
}
Background {
  skyColor [
    0.55 0.72 0.85
  ]
}
DirectionalLight {
  direction 0.6 -0.5 -1
  intensity 3
  castShadows TRUE
}
PointLight {
  location 0 0 3.5
  intensity 10
  attenuation 0 0 1
}

# ---------- ПОЛ + СТЕНЫ (статичные) ----------
DEF FLOOR Solid {
  translation 0 0 -0.01
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.82 0.80 0.74 roughness 1 metalness 0 }
      geometry DEF FLOOR_BOX Box { size 6 4 0.02 }
    }
  ]
  name "floor"
  boundingObject USE FLOOR_BOX
}
DEF WALL_PX Solid {
  translation 3 0 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.78 0.8 roughness 1 metalness 0 }
      geometry DEF WALL_NS Box { size 0.05 4 0.3 }
    }
  ]
  name "wall_px"
  boundingObject USE WALL_NS
}
DEF WALL_NX Solid {
  translation -3 0 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.78 0.8 roughness 1 metalness 0 }
      geometry USE WALL_NS
    }
  ]
  name "wall_nx"
  boundingObject USE WALL_NS
}
DEF WALL_PY Solid {
  translation 0 2 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.78 0.8 roughness 1 metalness 0 }
      geometry DEF WALL_EW Box { size 6 0.05 0.3 }
    }
  ]
  name "wall_py"
  boundingObject USE WALL_EW
}
DEF WALL_NY Solid {
  translation 0 -2 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.7 0.78 0.8 roughness 1 metalness 0 }
      geometry USE WALL_EW
    }
  ]
  name "wall_ny"
  boundingObject USE WALL_EW
}

# ---------- ГРЯДКИ (3 ряда по 2 сегмента) ----------
# Каждая грядка: длинный зелёный бокс 2.0 x 0.4 x 0.3.
# Ряды по y = -1.2, 0, 1.2; сегменты по x = -1.3 и 1.3 (проход по центру).
DEF BED_R1A Solid {
  translation -1.3 -1.2 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.55 0.22 roughness 1 metalness 0 }
      geometry DEF BED Box { size 1.6 0.4 0.3 }
    }
  ]
  name "bed_r1a"
  boundingObject USE BED
}
DEF BED_R1B Solid {
  translation 1.3 -1.2 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.55 0.22 roughness 1 metalness 0 }
      geometry USE BED
    }
  ]
  name "bed_r1b"
  boundingObject USE BED
}
DEF BED_R2A Solid {
  translation -1.3 0 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.55 0.22 roughness 1 metalness 0 }
      geometry USE BED
    }
  ]
  name "bed_r2a"
  boundingObject USE BED
}
DEF BED_R2B Solid {
  translation 1.3 0 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.55 0.22 roughness 1 metalness 0 }
      geometry USE BED
    }
  ]
  name "bed_r2b"
  boundingObject USE BED
}
DEF BED_R3A Solid {
  translation -1.3 1.2 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.55 0.22 roughness 1 metalness 0 }
      geometry USE BED
    }
  ]
  name "bed_r3a"
  boundingObject USE BED
}
DEF BED_R3B Solid {
  translation 1.3 1.2 0.15
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.28 0.55 0.22 roughness 1 metalness 0 }
      geometry USE BED
    }
  ]
  name "bed_r3b"
  boundingObject USE BED
}

# ---------- БОЧКИ С ВОДОЙ (для разнообразия карты) ----------
DEF BARREL1 Solid {
  translation 2.6 1.6 0.2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.45 0.7 roughness 1 metalness 0 }
      geometry DEF BARREL Cylinder { height 0.4 radius 0.15 }
    }
  ]
  name "barrel1"
  boundingObject USE BARREL
}
DEF BARREL2 Solid {
  translation 2.6 -1.6 0.2
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.25 0.45 0.7 roughness 1 metalness 0 }
      geometry USE BARREL
    }
  ]
  name "barrel2"
  boundingObject USE BARREL
}

# ---------- РОБОТ ----------
Robot {
  translation -2.7 0 0.04
  children [
    DEF BODY Shape {
      appearance PBRAppearance { baseColor 0.15 0.5 0.85 roughness 1 metalness 0 }
      geometry Box { size 0.2 0.12 0.05 }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.06 -0.06 0 }
      device [ RotationalMotor { name "wheel1" } PositionSensor { name "wheel1_sensor" } ]
      endPoint Solid {
        translation 0.06 -0.06 0
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL Shape {
            appearance PBRAppearance { baseColor 0.15 0.15 0.15 roughness 1 metalness 0 }
            geometry Cylinder { height 0.02 radius 0.04 }
          }
        ]
        name "wheel1"
        boundingObject USE WHEEL
        physics Physics {}
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0.06 0.06 0 }
      device [ RotationalMotor { name "wheel2" } PositionSensor { name "wheel2_sensor" } ]
      endPoint Solid {
        translation 0.06 0.06 0
        rotation 1 0 0 1.5708
        children [ USE WHEEL ]
        name "wheel2"
        boundingObject USE WHEEL
        physics Physics {}
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.06 -0.06 0 }
      device [ RotationalMotor { name "wheel3" } PositionSensor { name "wheel3_sensor" } ]
      endPoint Solid {
        translation -0.06 -0.06 0
        rotation 1 0 0 1.5708
        children [ USE WHEEL ]
        name "wheel3"
        boundingObject USE WHEEL
        physics Physics {}
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor -0.06 0.06 0 }
      device [ RotationalMotor { name "wheel4" } PositionSensor { name "wheel4_sensor" } ]
      endPoint Solid {
        translation -0.06 0.06 0
        rotation 1 0 0 1.5708
        children [ USE WHEEL ]
        name "wheel4"
        boundingObject USE WHEEL
        physics Physics {}
      }
    }
    DistanceSensor {
      translation 0.1 0.035 0.02
      rotation 0 0 1 0.3
      name "ds_left"
      lookupTable [ 0 1000 0 0.05 1000 0 1.0 0 0 ]
    }
    DistanceSensor {
      translation 0.1 -0.035 0.02
      rotation 0 0 1 -0.3
      name "ds_right"
      lookupTable [ 0 1000 0 0.05 1000 0 1.0 0 0 ]
    }
    Lidar {
      translation 0 0 0.06
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.283185
      numberOfLayers 1
      maxRange 8
    }
    Camera {
      translation 0.1 0 0.03
      name "camera"
      width 128
      height 64
    }
    GPS { name "gps" }
    InertialUnit { name "imu" }
    Display { name "map_display" width 220 height 220 }
  ]
  name "my_robot"
  boundingObject USE BODY
  physics Physics { density -1 mass 1 }
  controller "slam_mapper"
}
